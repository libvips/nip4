                    "type" : "git",
                    "url" : "https://github.com/libvips/libvips.git",
                    "commit" : "8afe930265361c9f6a047ffc4e2f836b940bc1ac"
                }
            ]
        },


        {
            "name" : "libgsl",
            "builddir" : true,
            "buildsystem" : "autotools",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://ftp.snt.utwente.nl/pub/software/gnu/gsl/gsl-2.8.tar.gz",
                    "sha256" : "6a99eeed15632c6354895b1dd542ed5a855c0f15d9ad1326c6fe2b2c9e423190"
                }
            ],
            "cleanup" : [
                "/bin"
            ]
        },

        {
            "name" : "nip4",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dflatpak=true"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/jcupitt/nip4.git",
                    "commit" : "f5a248df52f536bea9441310f3f990629be796f2"
