            "buildsystem" : "meson",
            "config-opts" : [
                "--libdir=lib",
                "--buildtype=release"
            ],
            "builddir" : true,
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/dloebl/cgif.git",
                    "tag" : "v0.5.4",
                    "commit" : "2dfb49c22fbe3894e46731f7e3b6ffa84311e44e"
                }
            ]
        },

        {
            "name" : "libraw",
            "builddir" : true,
            "buildsystem" : "autotools",
            "config-opts" : [
                "--disable-examples",
                "--enable-openmp",
                "--enable-jpeg",
                "--enable-zlib",
                "--enable-lcms"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://www.libraw.org/data/LibRaw-0.22.2.tar.gz",
                    "sha256" : "de86b035655accff8d4010f1a221fdf50d353cb7b1422ba26f14a0db92612cfa"
                }
            ]
        },

        {
            "name" : "imagemagick",
            "builddir" : true,
            "buildsystem" : "autotools",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/ImageMagick/ImageMagick",
                    "tag" : "7.1.2-31",
                    "commit" : "fb965f1b54a65ddb633f8c2eac4452c782c66d7f"
                }
            ]
        },

        {
            "name" : "libvips",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "--libdir=lib",
                "-Ddeprecated=false",
                "-Dmodules=disabled"
            ],
            "sources" : [
