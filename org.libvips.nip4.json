{
    "app-id" : "org.libvips.nip4",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "command" : "nip4",
    "finish-args" : [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--talk-name=org.gtk.vfs.*",
        "--filesystem=xdg-run/gvfsd",
        "--filesystem=host"
    ],
    "cleanup" : [
        "/include",

        "/bin/Magick++-config",
        "/bin/MagickCore-config",
        "/bin/MagickWand-config",
        "/bin/animate",
        "/bin/compare",
        "/bin/composite",
        "/bin/conjure",
        "/bin/convert",
        "/bin/cookbook",
        "/bin/dcm-dump",
        "/bin/dcm-getframe",
        "/bin/display",
        "/bin/exr2aces",
        "/bin/exrenvmap",
        "/bin/exrheader",
        "/bin/exrinfo",
        "/bin/exrmakepreview",
        "/bin/exrmaketiled",
        "/bin/exrmanifest",
        "/bin/exrmetrics",
        "/bin/exrmultipart",
        "/bin/exrmultiview",
        "/bin/exrstdattr",
        "/bin/fitscopy",
        "/bin/fitsverify",
        "/bin/fpack",
        "/bin/funpack",
        "/bin/identify",
        "/bin/imcopy",
        "/bin/import",
        "/bin/libdeflate-gunzip",
        "/bin/libdeflate-gzip",
        "/bin/libpng-config",
        "/bin/libpng18-config",
        "/bin/magick",
        "/bin/magick-script",
        "/bin/mogrify",
        "/bin/montage",
        "/bin/ojph_compress",
        "/bin/ojph_expand",
        "/bin/openslide-quickhash1sum",
        "/bin/openslide-show-properties",
        "/bin/openslide-write-png",
        "/bin/png-fix-itxt",
        "/bin/pngfix",
        "/bin/slidetool",
        "/bin/smem",
        "/bin/snip",
        "/bin/speed",
        "/bin/stream",
        "/bin/vips",
        "/bin/vipsedit",
        "/bin/vipsheader",
        "/bin/vipsthumbnail",

        "/lib/lib*.a",
        "/lib/lib*.la",
        "/lib/ImageMagick-*",
        "/lib/cmake",
        "/lib/girepository-1.0",
        "/lib/libMagick++-7*",
        "/lib/pkgconfig",

        "/share/aclocal",
        "/share/doc",
        "/share/gir-1.0",
        "/share/man",
        "/share/pkgconfig",
        "/share/aclocal*",
        "/share/info"

    ],
    "modules" : [

        {
            "name" : "libdeflate",
            "builddir" : true,
            "buildsystem" : "cmake-ninja",
            "build-options" : {
                "config-opts" : [
                    "-DCMAKE_INSTALL_LIBDIR=lib"
                ]
            },
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/ebiggers/libdeflate.git",
                    "tag" : "v1.26",
                    "commit" : "92e6a0db9fa848d742f9eb286c92afc60f2c3dda"
                }
            ]
        },

        {
            "name" : "libpng",
            "builddir" : true,
            "buildsystem" : "autotools",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/pnggroup/libpng.git",
                    "commit" : "964b4135949703b705fc760fc3fb546b86e5ab47"
                }
            ]
        },

        {
            "name" : "openjph",
            "builddir" : true,
            "buildsystem" : "cmake-ninja",
            "build-options" : {
                "config-opts" : [
                    "-DCMAKE_INSTALL_LIBDIR=lib"
                ]
            },
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/aous72/OpenJPH.git",
                    "tag" : "0.31.0",
                    "commit" : "c68064d0e4cad8e96bab9a068f6cc4e7799744fc"
                }
            ]
        },

        {
            "name" : "libimagequant",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "--libdir=lib",
                "--buildtype=release"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/lovell/libimagequant.git",
                    "commit" : "ce5fdeb1ccd9db288950faa21fd09c42c0a59bbb"
                }
            ]
        },

        {
            "name" : "poppler-data",
            "builddir" : true,
            "buildsystem" : "cmake-ninja",
            "build-options" : {
                "config-opts" : [
                    "-DCMAKE_INSTALL_LIBDIR=lib"
                ]
            },
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://poppler.freedesktop.org/poppler-data-0.4.12.tar.gz",

                    "sha256" : "c835b640a40ce357e1b83666aabd95edffa24ddddd49b8daff63adb851cdab74"
                }
            ]
        },

        {
            "name" : "poppler-glib",
            "builddir" : true,
            "buildsystem" : "cmake-ninja",
            "config-opts" : [
                    "-DCMAKE_INSTALL_LIBDIR=lib",
                    "-DBUILD_CPP_TESTS=OFF",
                    "-DBUILD_GTK_TESTS=OFF",
                    "-DBUILD_MANUAL_TESTS=OFF",
                    "-DBUILD_QT5_TESTS=OFF",
                    "-DBUILD_QT6_TESTS=OFF",
                    "-DENABLE_LIBTIFF=ON",
                    "-DENABLE_LIBPNG=ON",
                    "-DENABLE_GLIB=ON",
                    "-DENABLE_LIBOPENJPEG='openjpeg2'",
                    "-DENABLE_DCTDECODER='libjpeg'",
                    "-DENABLE_BOOST=OFF",
                    "-DENABLE_UTILS=OFF",
                    "-DENABLE_QT5=OFF",
                    "-DENABLE_QT6=OFF",
                    "-DENABLE_CPP=OFF"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://poppler.freedesktop.org/poppler-26.09.0.tar.xz",

                    "sha256" : "8059eadb6805340768f138c465b57f8164c92b4a0773c37ef031ea6c0d987b2e"
                }
            ]
        },

        {
            "name" : "imath",
            "builddir" : true,
            "buildsystem" : "cmake-ninja",
            "build-options" : {
                "config-opts" : [
                    "-DCMAKE_INSTALL_LIBDIR=lib"
                ]
            },
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/AcademySoftwareFoundation/Imath.git",
                    "tag" : "v3.2.3",
                    "commit" : "5f27ba266d3ea1565e912570c30b5eafc89959f1"
                }
            ]
        },

        {
            "name" : "openexr",
            "builddir" : true,
            "buildsystem" : "cmake-ninja",
            "build-options" : {
                "config-opts" : [
                    "-DCMAKE_INSTALL_LIBDIR=lib"
                ]
            },
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/AcademySoftwareFoundation/openexr.git",
                    "tag" : "v3.4.15",
                    "commit" : "e71cdd5d30a146dcb56c5e4c576d9e9d3c45f4fb"
                }
            ]
        },

        {
            "name" : "libultrahdr",
            "builddir" : true,
            "buildsystem" : "cmake-ninja",
            "build-options" : {
                "config-opts" : [
                    "-DCMAKE_INSTALL_LIBDIR=lib",
                    "-DUHDR_BUILD_BENCHMARK=OFF",
                    "-DUHDR_BUILD_DEPS=OFF",
                    "-DUHDR_BUILD_EXAMPLES=OFF",
                    "-DUHDR_BUILD_FUZZERS=OFF",
                    "-DUHDR_BUILD_JAVA=OFF",
                    "-DUHDR_BUILD_PACKAGING=OFF",
                    "-DUHDR_BUILD_TESTS=OFF",
                    "-DUHDR_ENABLE_GLES=OFF",
                    "-DUHDR_ENABLE_LOGS=OFF",
                    "-DUHDR_ENABLE_WERROR=OFF",
                    "-DUHDR_WRITE_ISO=ON",
                    "-DUHDR_WRITE_XMP=OFF"
                ]
            },
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/google/libultrahdr.git",
                    "commit" : "e5f5a022fe96fc4dc2ee35c19f733a50df807abe"
                }
            ]
        },

        {
            "name" : "uthash",
            "buildsystem" : "simple",
            "build-commands" : [
                "install -D include/* /app/include"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/troydhanson/uthash.git",
                    "commit" : "a49bed0b4abb7dff16c73906dcdc8a9718d582d2"
                }
            ]
        },

        {
            "name" : "libdicom",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "--buildtype=release",
                "--libdir=lib",
                "-Dtests=false"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/ImagingDataCommons/libdicom.git",
                    "tag" : "v1.3.0",
                    "commit" : "8c84fdbef433395619f3b099e939d36877a9d48f"
